# Supabase project settings: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Set these in Supabase Edge Function secrets, NOT in VITE_ browser variables.
# Provider keys must never be committed or exposed to the browser.
# IMAGE_PROVIDER=replicate
# IMAGE_PROVIDER_API_KEY=your-secret-key
# IMAGE_PROVIDER_MODEL=your-selected-model
